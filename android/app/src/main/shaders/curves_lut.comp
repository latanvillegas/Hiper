#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform readonly image2D uInputImage;
layout(binding = 1, rgba8) uniform writeonly image2D uOutputImage;
layout(binding = 2) uniform sampler2D uCurveLutTexture; // 256x1 RGBA LUT

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uInputImage);

    if (coord.x >= size.x || coord.y >= size.y) return;

    vec4 color = imageLoad(uInputImage, coord);

    // Sample from 1D curve LUT for each RGB channel
    float r = texture(uCurveLutTexture, vec2(color.r, 0.5)).r;
    float g = texture(uCurveLutTexture, vec2(color.g, 0.5)).g;
    float b = texture(uCurveLutTexture, vec2(color.b, 0.5)).b;

    imageStore(uOutputImage, coord, vec4(r, g, b, color.a));
}
