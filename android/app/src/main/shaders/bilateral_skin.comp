#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform readonly image2D uInputImage;
layout(binding = 1, r8) uniform readonly image2D uSkinMask;
layout(binding = 2, rgba8) uniform writeonly image2D uOutputImage;

layout(push_constant) uniform PushConsts {
    float spatialSigma;
    float rangeSigma;
    float texturePreservation;
    float maskThreshold;
} params;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uInputImage);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec4 centerColor = imageLoad(uInputImage, coord);
    float skinWeight = imageLoad(uSkinMask, coord).r;

    if (skinWeight < 0.05) {
        imageStore(uOutputImage, coord, centerColor);
        return;
    }

    float centerLum = dot(centerColor.rgb, vec3(0.299, 0.587, 0.114));
    int radius = int(clamp(params.spatialSigma * 2.0, 1.0, 10.0));

    float spatialCoeff = -0.5 / (params.spatialSigma * params.spatialSigma);
    float rangeCoeff = -0.5 / (params.rangeSigma * params.rangeSigma);

    vec3 sumColor = vec3(0.0);
    float sumWeight = 0.0;

    for (int dy = -radius; dy <= radius; dy++) {
        for (int dx = -radius; dx <= radius; dx++) {
            ivec2 neighborCoord = clamp(coord + ivec2(dx, dy), ivec2(0), size - ivec2(1));
            vec4 neighborColor = imageLoad(uInputImage, neighborCoord);
            float neighborLum = dot(neighborColor.rgb, vec3(0.299, 0.587, 0.114));

            float distSq = float(dx * dx + dy * dy);
            float lumDiff = neighborLum - centerLum;

            float w = exp(distSq * spatialCoeff + (lumDiff * lumDiff) * rangeCoeff);
            sumColor += neighborColor.rgb * w;
            sumWeight += w;
        }
    }

    vec3 smoothed = sumColor / sumWeight;
    vec3 highPass = centerColor.rgb - smoothed;
    vec3 preserved = smoothed + highPass * params.texturePreservation;

    vec3 finalRgb = mix(centerColor.rgb, preserved, skinWeight);
    imageStore(uOutputImage, coord, vec4(finalRgb, centerColor.a));
}
