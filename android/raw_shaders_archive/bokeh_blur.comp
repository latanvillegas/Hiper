#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform readonly image2D uInputImage;
layout(binding = 1, rgba8) uniform writeonly image2D uOutputImage;
layout(binding = 2) uniform sampler2D uSamplerImage;

layout(push_constant) uniform BokehParams {
    float blurRadius;
    float bladeCount;
    float bladeCurvature;
    float specularThreshold;
    float specularBoost;
    float chromaticAberration;
} params;

#define PI 3.14159265359

float sampleAperture(vec2 p, float blades, float curvature) {
    float r = length(p);
    if (r > 1.0) return 0.0;
    if (blades <= 2.0) return 1.0 - smoothstep(0.92, 1.0, r);

    float angle = atan(p.y, p.x) + PI;
    float sector = (2.0 * PI) / blades;
    float localAngle = mod(angle, sector) - (sector * 0.5);
    float polyR = cos(sector * 0.5) / cos(localAngle);

    float blendR = mix(polyR, 1.0, curvature);
    return r <= blendR ? 1.0 : 0.0;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uInputImage);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(size);
    if (params.blurRadius <= 0.5) {
        imageStore(uOutputImage, coord, imageLoad(uInputImage, coord));
        return;
    }

    vec3 sumColor = vec3(0.0);
    float totalWeight = 0.0;

    // Concentric Fibonacci bokeh disc sampling (48 samples)
    int sampleCount = 48;
    for (int i = 0; i < sampleCount; i++) {
        float fi = float(i);
        float r = sqrt((fi + 0.5) / float(sampleCount));
        float theta = fi * 2.39996323; // Golden angle

        vec2 offsetNorm = vec2(cos(theta), sin(theta)) * r;
        float apWeight = sampleAperture(offsetNorm, params.bladeCount, params.bladeCurvature);
        if (apWeight <= 0.0) continue;

        vec2 offsetPixels = offsetNorm * params.blurRadius;
        vec2 sampleUv = uv + offsetPixels / vec2(size);

        // Chromatic aberration fringe on bokeh discs
        float rCol = texture(uSamplerImage, sampleUv + (offsetPixels * params.chromaticAberration * 0.02) / vec2(size)).r;
        float gCol = texture(uSamplerImage, sampleUv).g;
        float bCol = texture(uSamplerImage, sampleUv - (offsetPixels * params.chromaticAberration * 0.02) / vec2(size)).b;

        vec3 sampleColor = vec3(rCol, gCol, bCol);
        float luma = dot(sampleColor, vec3(0.2126, 0.7152, 0.0722));

        // Specular highlight boost
        float boost = luma > params.specularThreshold ? pow((luma - params.specularThreshold) / (1.0 - params.specularThreshold + 0.001), 2.0) * params.specularBoost : 0.0;
        float sampleW = apWeight * (1.0 + boost);

        sumColor += sampleColor * sampleW;
        totalWeight += sampleW;
    }

    vec3 finalColor = totalWeight > 0.0 ? sumColor / totalWeight : texture(uSamplerImage, uv).rgb;
    imageStore(uOutputImage, coord, vec4(finalColor, 1.0));
}
