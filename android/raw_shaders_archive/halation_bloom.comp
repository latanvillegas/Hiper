#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform readonly image2D uInputImage;
layout(binding = 1, rgba8) uniform writeonly image2D uOutputImage;
layout(binding = 2) uniform sampler2D uBloomBlurSampler;

layout(push_constant) uniform HalationBloomParams {
    float halationIntensity;
    float halationThreshold;
    float bloomIntensity;
    float bloomThreshold;
} params;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uInputImage);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(size);
    vec4 baseColor = imageLoad(uInputImage, coord);
    vec4 blurred = texture(uBloomBlurSampler, uv);

    float luma = dot(baseColor.rgb, vec3(0.2126, 0.7152, 0.0722));

    // Vintage film halation (characteristic Kodak 2383 warm red-orange spectral fringe)
    vec3 halationColor = vec3(1.0, 0.22, 0.04);
    float halationMask = smoothstep(params.halationThreshold, 1.0, luma) * params.halationIntensity;
    vec3 halated = baseColor.rgb + halationColor * halationMask * blurred.r;

    // Optical glass bloom
    vec3 bloomed = halated + blurred.rgb * params.bloomIntensity;

    imageStore(uOutputImage, coord, vec4(clamp(bloomed, 0.0, 1.0), baseColor.a));
}
